 ```powershell
 git switch main
 git pull --ff-only origin main
-git revert <SHA_DEL_COMMIT_PUBLICADO>
-git push origin main
+git revert <SHA_DEL_COMMIT_FUSIONADO>
+git push -u origin revert-coste-cero-20261015
 ```
 
